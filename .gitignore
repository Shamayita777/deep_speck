# Python
__pycache__/
*.py[cod]

# Virtual environments
venv/
.venv/

# macOS
.DS_Store

# Jupyter
.ipynb_checkpoints/

# TensorBoard logs (if you create them later)
logs/

# Temporary files
*.log
# Audit run evidence: these .log files are deliberate verification
# records (test runs, regression suites), not build noise. The global
# *.log rule above would silently drop them from history.
!audit/targets/autond/run_evidence/*.log
