      },
      "NO_DIRECTIONAL_CLAIM|EQUIVALENT_WITHIN_MARGIN": {
        "conclusion": "IMPLEMENTATIONS_EQUIVALENT",
        "meaning": "The two implementations produce statistically equivalent experimental outcomes within the preregistered margin, on this endpoint and this sealed test set. This is the condition methodology Section 3.5.6 Rule I states."
      },
      "NO_DIRECTIONAL_CLAIM|INCONCLUSIVE": {
        "conclusion": "INCONCLUSIVE",
        "meaning": "No directional difference is supported and equivalence is not established. The data are compatible with both; this is an absence of evidence, not evidence of agreement."
      },
      "NO_DIRECTIONAL_CLAIM|NOT_EQUIVALENT": {
        "conclusion": "INCONCLUSIVE",
        "meaning": "Equivalence rejected without a supported direction: the data are too dispersed to place the difference, which is an INCONCLUSIVE result rather than a finding."
      }
    },
    "methodology_reference": "Section 3.5.6 Rule I",
    "rule_version": "II4-IMPL-INTERPRETATION-V1",
    "unmapped_combination": {
      "conclusion": "INCONCLUSIVE",
      "meaning": "A (materiality, equivalence) pair not present in the frozen map is reported as INCONCLUSIVE with the pair recorded verbatim. An unanticipated combination is never resolved by choosing the more favourable reading."
