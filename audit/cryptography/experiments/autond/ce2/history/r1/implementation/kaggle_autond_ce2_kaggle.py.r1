"""
AutoND CE2 command-line entry point.

Run from the directory that contains the `audit` package (or pass --repo-root):

    python -m audit.cryptography.kaggle.autond_ce2_kaggle --check-model --report <new.json>
    python -m audit.cryptography.kaggle.autond_ce2_kaggle --validate-math --report <new.json>
    python -m audit.cryptography.kaggle.autond_ce2_kaggle --power --report <new.json>
    python -m audit.cryptography.kaggle.autond_ce2_kaggle --preflight
    python -m audit.cryptography.kaggle.autond_ce2_kaggle --smoke --out <dir>/autond_ce2_smoke_<stamp>
    python -m audit.cryptography.kaggle.autond_ce2_kaggle --run-all --out <dir>      (production; approved preregistration)
    python -m audit.cryptography.kaggle.autond_ce2_kaggle --resume --out <dir>
    python -m audit.cryptography.kaggle.autond_ce2_kaggle --run K --out <dir>
    python -m audit.cryptography.kaggle.autond_ce2_kaggle --finalize --out <dir>
    python -m audit.cryptography.kaggle.autond_ce2_kaggle --verify --out <dir> [--skip-model-recompute]

--finalize and --verify never generate data or evaluate a model on new data. No mode trains a model.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

MODES = ("check_model", "validate_math", "power", "preflight", "smoke", "run_all", "resume", "run",
         "finalize", "verify")


def _parse(argv):
    ap = argparse.ArgumentParser(description="AutoND CE2 theory consistency")
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--check-model", action="store_true")
    g.add_argument("--validate-math", action="store_true")
    g.add_argument("--power", action="store_true")
    g.add_argument("--preflight", action="store_true")
    g.add_argument("--smoke", action="store_true")
    g.add_argument("--run-all", action="store_true")
    g.add_argument("--resume", action="store_true")
    g.add_argument("--run", type=int, metavar="K")
    g.add_argument("--finalize", action="store_true")
    g.add_argument("--verify", action="store_true")
    ap.add_argument("--out", type=Path)
    ap.add_argument("--report", type=Path, help="new JSON file for --check-model/--validate-math/--power/--preflight")
    ap.add_argument("--repo-root", type=Path, default=None, help="directory containing the audit package")
    ap.add_argument("--upstream", type=Path, default=None, help="pinned AutoND upstream root")
    ap.add_argument("--gpu", type=str, default=None, help="value for CUDA_VISIBLE_DEVICES")
    ap.add_argument("--skip-model-recompute", action="store_true")
    a = ap.parse_args(argv)
    if a.run is not None and a.run < 0:
        ap.error("--run K requires K >= 0")
    needs_out = a.smoke or a.run_all or a.resume or a.run is not None or a.finalize or a.verify
    if needs_out and a.out is None:
        ap.error("this mode requires --out")
    if not needs_out and a.out is not None:
        ap.error("--out is only valid for smoke/run/resume/finalize/verify")
    if a.report is not None and not (a.check_model or a.validate_math or a.power or a.preflight):
        ap.error("--report is only valid for --check-model/--validate-math/--power/--preflight")
    if a.skip_model_recompute and not a.verify:
        ap.error("--skip-model-recompute is only valid with --verify")
    return a


def _emit(obj, report: Path | None):
    text = json.dumps(obj, indent=1, sort_keys=True, default=str) + "\n"
    if report is None:
        print(text)
        return
    if report.exists():
        raise SystemExit(f"[FATAL] refusing to overwrite {report}")
    report.parent.mkdir(parents=True, exist_ok=True)
    report.write_text(text)
    print(f"wrote {report}")


def main(argv=None) -> int:
    a = _parse(argv)
    if a.gpu is not None:
        os.environ["CUDA_VISIBLE_DEVICES"] = a.gpu
    os.environ.setdefault("TF_CPP_MIN_LOG_LEVEL", "2")
    root = (a.repo_root or Path.cwd()).resolve()
    if not (root / "audit" / "cryptography").is_dir():
        print(f"[FATAL] no audit/cryptography package under {root}", file=sys.stderr)
        return 2
    sys.path.insert(0, str(root))

    from audit.cryptography import frozen_design_autond_ce2 as FD
    from audit.cryptography.adapters import autond_ce2 as A
    from audit.cryptography.experiments.ce2 import autond_ce2 as S
    from audit.cryptography.experiments.ce2 import autond_runner as R
    from audit.cryptography.experiments.ce2 import autond_verify as V

    if a.check_model:
        up = A.Upstream(a.upstream)
        model, binding = A.load_published_model(up)
        corpus = A.generate_genuine_pairs(up, 256)["arrays"]
        X = A.model_input(up, corpus["c0"], corpus["c1"])
        _emit({"report": "AutoND CE2 read-only model binding check", "utc": R.utc(),
               "environment": R.environment(), "runtime_problems": R.runtime_problems(R.environment()),
               "upstream": up.verification, "model_binding": binding,
               "inference_mode": A.inference_mode_check(model, X),
               "inference_batch": "256 fresh non-evidentiary genuine pairs; scores not retained",
               "not_performed": ["fit", "training", "saving weights", "modifying the checkpoint",
                                 "generating CE2 production data", "writing to AutoND CE1 directories"]},
              a.report)
        return 0
    if a.validate_math:
        up = A.Upstream(a.upstream)
        corpus = A.generate_genuine_pairs(up, FD.DESIGN["mathematical_gates"]["preflight_corpus_pairs"])
        c = corpus["arrays"]
        alpha = up.cipher.ror(c["dx"][0, :-1], up.cipher.ALPHA())
        first = sorted({(int(x), int(y), int(z)) for x, y, z in zip(alpha, c["dy"][0, :-1], c["dx"][0, 1:])})
        gates = R.math_gates("production", first)
        gates["E"], gates["F"] = corpus["gates"]["E"], corpus["gates"]["F"]
        gates["upstream_encoding"] = R.upstream_encoding_check(up)
        gates["corpus"] = "non-evidentiary, 4096 fresh genuine pairs, not retained"
        _emit({"report": "AutoND CE2 mathematical verification", "utc": R.utc(), **gates}, a.report)
        return 0 if gates["passed"] and gates["E"]["passed"] and gates["F"]["passed"] else 1
    if a.power:
        _emit({"report": "AutoND CE2 power analysis", "utc": R.utc(), **S.power_analysis()}, a.report)
        return 0
    if a.preflight:
        up = A.Upstream(a.upstream)
        rep = R.preflight(up, "production")
        _emit(rep, a.report)
        return 0 if rep["ok"] else 1
    if a.smoke:
        stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        out = a.out if a.out.name.startswith(R.SMOKE_PREFIX) else a.out / f"{R.SMOKE_PREFIX}{stamp}"
        R.initialise(out, "smoke", upstream=a.upstream)
        R.run_all(out, upstream=a.upstream)
        cert = R.finalize(out)
        print(f"SMOKE_NOT_CONFIRMATORY decision={cert['decision']} -> {out}")
        return V.main([str(out)] + (["--upstream", str(a.upstream)] if a.upstream else []))
    if a.run_all:
        if (a.out / "run_manifest.json").exists():
            print("[FATAL] output directory already initialised; use --resume", file=sys.stderr)
            return 2
        man = R.initialise(a.out, "production", upstream=a.upstream)
        if man["status"] != "INITIALISED":
            print(f"[STOP] initialisation status {man['status']}; finalize to record PRECHECK_FAILED")
            return 1
        recs = R.run_all(a.out, upstream=a.upstream)
    elif a.resume:
        recs = R.run_all(a.out, upstream=a.upstream)
    elif a.run is not None:
        recs = R.run_all(a.out, upstream=a.upstream, only=a.run)
    elif a.finalize:
        cert = R.finalize(a.out)
        print(f"decision={cert['decision']}: {cert['decision_reason']}")
        return 0
    else:
        return V.main([str(a.out)] + (["--upstream", str(a.upstream)] if a.upstream else []) +
                      (["--skip-model-recompute"] if a.skip_model_recompute else []))
    for r in recs:
        print(f"{r['run_id']}: {r['state']}" + (f" ({r.get('failure') or r.get('reason')})"
                                               if r["state"] in ("FAILED", "EXCLUDED") else ""))
    return 0 if all(r["state"] in ("VALID", "EXCLUDED") for r in recs) else 1


if __name__ == "__main__":
    sys.exit(main())
